# ==============================================================================
# Kafka Demo Konfigürasyon Şablonu (.env.example)
# ==============================================================================
# Bu dosya bir şablondur. Gerçek şifre ve bağlantı bilgilerinizi buraya YAZMAYINIZ.
# Kendi ortamınız için bu dosyayı kopyalayarak '.env' adında bir dosya oluşturabilir
# veya bu değişkenleri sistem/terminal ortam değişkeni olarak tanımlayabilirsiniz.
#
# DİKKAT: '.env' dosyası .gitignore tarafından korunmakta olup asla Git'e yüklenmemelidir!

# ------------------------------------------------------------------------------
# 1. TEMEL BAĞLANTI AYARLARI
# ------------------------------------------------------------------------------
# Kafka broker adresleri (Virgülle ayrılmış liste)
# Yerel 3-broker docker kümesi için varsayılan:
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9094,localhost:9096

# Kullanılacak Topic Adı
KAFKA_TOPIC=siparis-olaylari

# Consumer Grubu Adı
KAFKA_GROUP_ID=siparis-takip-servisi

# ------------------------------------------------------------------------------
# 2. BULUT & GÜVENLİK KİMLİK DOĞRULAMA (SASL / SSL)
# ------------------------------------------------------------------------------
# Confluent Cloud, Upstash, Aiven, AWS MSK veya kurumsal Kafka gibi
# kimlik doğrulama gerektiren bir kümeye bağlanırken aşağıdaki satırların
# başındaki '#' işaretini kaldırıp bilgilerinizi giriniz:

# KAFKA_SASL_USERNAME=your_username_or_api_key
# KAFKA_SASL_PASSWORD=your_secret_password_or_api_secret
# KAFKA_SECURITY_PROTOCOL=SaslSsl
# KAFKA_SASL_MECHANISM=Plain
